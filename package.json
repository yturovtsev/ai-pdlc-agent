{
  "name": "agent-pdlc",
  "version": "0.1.0",
  "private": true,
  "description": "Конвейер spec-driven разработки на Qwen Code: контроллер agentflow и пять ролей-субагентов",
  "type": "module",
  "bin": {
    "agentflow": "tools/agentflow/bin/agentflow.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "agentflow": "tsx tools/agentflow/controller.ts",
    "smoke": "tsx tools/agentflow/smoke.ts",
    "lint": "bash tools/agentflow/run.sh lint",
    "test": "bash tools/agentflow/run.sh unit",
    "typecheck": "tsc --noEmit",
    "test:agentflow": "tsx --test tools/agentflow/*.test.ts"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.14.0",
    "@inquirer/prompts": "8.7.3",
    "@qwen-code/sdk": "0.1.8",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
